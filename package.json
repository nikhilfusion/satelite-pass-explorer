{
  "name": "satellite-pass-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "Map-centric explorer for satellite passes and ground-point accesses (DuckDB + Fastify + React + MapLibre).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @sat/api",
    "dev:web": "npm run dev -w @sat/web",
    "ingest": "npm run ingest -w @sat/api",
    "build": "npm run build -w @sat/web && npm run build -w @sat/api",
    "start": "npm run start -w @sat/api",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"apps/web/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @sat/web",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "globals": "^16.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.0",
    "stylelint": "^16.23.0",
    "stylelint-config-css-modules": "^4.5.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
